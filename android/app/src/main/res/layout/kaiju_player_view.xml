<?xml version="1.0" encoding="utf-8"?>
<!-- Media library player surface. A TextureView (not the default SurfaceView) so Compose can
     mirror the video for "show the other side"; the controls are the app's own, in Compose. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    app:resize_mode="fit"
    app:shutter_background_color="#FF0B0F0E"
    app:surface_type="texture_view"
    app:use_controller="false" />
